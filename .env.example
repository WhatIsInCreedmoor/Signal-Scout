# Security settings
DJANGO_SECRET_KEY=your_secure_random_string_here
DJANGO_DEBUG=False

# Networking (Comma-separated, no spaces)
ALLOWED_HOSTS=example.org,www.example.org,localhost,127.0.0.1,10.10.10.10
CSRF_TRUSTED_ORIGINS=https://example.org, https://www.example.org

# Localization
TIME_ZONE=America/New_York

# Site Name
SITE_NAME="Signal Scout"

# Default Map Center
MAP_CENTER_LAT=39.108455
MAP_CENTER_LON=-76.771193
MAP_DEFAULT_ZOOM=13
